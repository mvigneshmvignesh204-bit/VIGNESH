import re

def check_password_strength(password):
    if len(password) < 8:
        return "Too Short (Min 8 chars)"
    if not re.search("[a-z]", password):
        return "Missing lowercase letter"
    if not re.search("[A-Z]", password):
        return "Missing uppercase letter"
    if not re.search("[0-9]", password):
        return "Missing a number"
    if not re.search("[_@$!%*#?&]", password):
        return "Missing a special character"
    
    return "Strong Password!"

user_input = input("Enter a password to test: ")
print(f"Result: {check_password_strength(user_input)}")
